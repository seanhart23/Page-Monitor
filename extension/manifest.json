{
  "manifest_version": 3,
  "name": "Page Monitor",
  "version": "1.0",
  "description": "Monitor websites for changes",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "notifications",
    "alarms"
  ],
  "background": {
      "service_worker": "background.js",
      "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png"
  },
  "icons": {
    "128": "icons/icon.png"
  }
}