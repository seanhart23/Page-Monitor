{
  "manifest_version": 3,
  "name": "Smart Page Monitor",
  "version": "1.1.0",
  "description": "Monitor any webpage and get notified the moment content changes—no more refreshing tabs or checking manually.",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://smart-page-monitor-api.onrender.com/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/elementSelector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "ui/settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": "ui/icons/chrome_bubble_128.png"
  },
  "icons": {
    "128": "ui/icons/chrome_bubble_128.png"
  }
}